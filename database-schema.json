{
  "collections": {
    "teams": {
      "description": "Stores information about registered hackathon teams and their members. Document ID acts as the unique identifier (usually auto-generated, or legacy team name).",
      "documentId": "Auto-generated ID (or legacy lowercase teamName)",
      "fields": {
        "displayId": { "type": "string", "encrypted": false },
        "teamName": { "type": "string", "encrypted": false, "required": true },
        "teamNameLower": { "type": "string", "encrypted": false },
        "theme": { "type": "string", "encrypted": false },
        "psId": { "type": "string", "encrypted": false },
        "problemStatement": { "type": "string", "encrypted": false },
        "leadEmail": { "type": "string", "encrypted": false, "description": "Lowercase email of the team lead" },
        "leadData": {
          "type": "object",
          "encrypted": false,
          "description": "{ name, batchNumber, department, year, section, contactNumber, email }"
        },
        "membersData": {
          "type": "array",
          "encrypted": false,
          "description": "Array of { name, batchNumber, department, year, section }"
        },
        "allBatchNumbers": {
          "type": "array",
          "encrypted": false,
          "description": "Array of strings containing batch numbers of all team members"
        },
        "pptLink": { "type": "string", "encrypted": false, "nullable": true },
        "pptDriveFileId": { "type": "string", "encrypted": false, "nullable": true },
        "pptQualified": { "type": "boolean", "encrypted": false },
        "pptStatus": { "type": "string", "encrypted": false },
        "venue": { "type": "string", "encrypted": false, "nullable": true },
        "finalVenue": { "type": "string", "encrypted": false, "nullable": true },
        "score": { "type": "number", "encrypted": false },
        "judge": { "type": "string", "encrypted": false, "default": "Unassigned" },
        "labNo": { "type": "string", "encrypted": false, "default": "Unassigned" },
        "assignedLabId": { "type": "string", "encrypted": false },
        "assignedLabName": { "type": "string", "encrypted": false },
        "feedback": { "type": "string", "encrypted": false },
        "eliminated": { "type": "boolean", "encrypted": false },
        "eliminationReason": { "type": "string", "encrypted": false },
        "prelimsAverageScore": { "type": "number", "encrypted": false },
        "prelimsStatus": { "type": "string", "encrypted": false },
        "finaleQualified": { "type": "boolean", "encrypted": false },
        "finalStatus": { "type": "string", "encrypted": false },
        "isWinner": { "type": "boolean", "encrypted": false },
        "winnerRank": { "type": "number", "encrypted": false, "nullable": true },
        "winnerTitle": { "type": "string", "encrypted": false, "nullable": true },
        "totalGameXP": { "type": "number", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false },
        "updatedAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "roles": {
      "description": "Stores authentication and role mapping for privileged users.",
      "documentId": "email (lowercase)",
      "fields": {
        "role": { "type": "string", "encrypted": false, "description": "'admin', 'jury', or 'coordinator'" },
        "name": { "type": "string", "encrypted": false },
        "department": { "type": "string", "encrypted": false },
        "institution": { "type": "string", "encrypted": false },
        "juryId": { "type": "string", "encrypted": false, "description": "Optional: used for Jury" },
        "juryName": { "type": "string", "encrypted": false, "description": "Optional: used for Jury" },
        "migratedFrom": { "type": "string", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    },

    "evaluations": {
      "description": "Unified scoring submitted by Juries and Admins. Replaces prelimsEvaluations and finaleEvaluations.",
      "documentId": "Format: {round}_{juryId}_{teamId}",
      "fields": {
        "round": { "type": "string", "encrypted": false, "description": "'prelims' or 'finale'" },
        "teamId": { "type": "string", "encrypted": false },
        "teamName": { "type": "string", "encrypted": false },
        "displayId": { "type": "string", "encrypted": false },
        "juryId": { "type": "string", "encrypted": false },
        "juryName": { "type": "string", "encrypted": false },
        "rubric": {
          "type": "object",
          "description": "Contains jury fields (conceptStrength, buildIntelligence, deliveryImpact, liveDefenseScore, communication)"
        },
        "totalScore": { "type": "number", "encrypted": false },
        "remarks": { "type": "string", "encrypted": false },
        "feedback": { "type": "string", "encrypted": false },
        "highlighted": { "type": "boolean", "encrypted": false },
        "isFrozen": { "type": "boolean", "encrypted": false },
        "migratedFrom": { "type": "string", "encrypted": false, "description": "Set by migration script" },
        "createdAt": { "type": "timestamp", "encrypted": false },
        "updatedAt": { "type": "timestamp", "encrypted": false }
      }
    },

    "gameScores": {
      "description": "Stores Game XP assigned by student coordinators. Currently only queried by admin actions.",
      "documentId": "Auto-generated ID",
      "fields": {
        "teamId": { "type": "string", "encrypted": false },
        "studentCoordId": { "type": "string", "encrypted": false },
        "gameName": { "type": "string", "encrypted": false },
        "xpAwarded": { "type": "number", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "labs": {
      "description": "Lab assignments for Prelims",
      "documentId": "Auto-generated ID",
      "fields": {
        "labId": { "type": "string", "encrypted": false },
        "labName": { "type": "string", "encrypted": false },
        "labCode": { "type": "string", "encrypted": false },
        "capacity": { "type": "number", "encrypted": false },
        "assignedJuryId": { "type": "string", "encrypted": false },
        "assignedJuryName": { "type": "string", "encrypted": false },
        "assignedTheme": { "type": "string", "encrypted": false },
        "currentTeamCount": { "type": "number", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false },
        "updatedAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "finalLabs": {
      "description": "Lab assignments for Finale",
      "documentId": "Auto-generated ID",
      "fields": {
        "labId": { "type": "string", "encrypted": false },
        "labName": { "type": "string", "encrypted": false },
        "labCode": { "type": "string", "encrypted": false },
        "capacity": { "type": "number", "encrypted": false },
        "coordinator": { "type": "string", "encrypted": false },
        "currentTeamCount": { "type": "number", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false },
        "updatedAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "metadata": {
      "description": "Global metadata and counters.",
      "documentId": "teamCounter | eventTimelines | eventWinners",
      "fields": {
        "count": { "type": "number", "encrypted": false, "description": "For teamCounter" },
        "timeline1": { "type": "object", "encrypted": false, "description": "{ name, state, enabled, startDate, endDate } for eventTimelines" },
        "timeline2": { "type": "object", "encrypted": false, "description": "{ name, state, enabled, startDate, endDate, pptFilterApplied } for eventTimelines" },
        "timeline3": { "type": "object", "encrypted": false, "description": "{ name, state, enabled, startDate, endDate, topTeamsToFinal, finalistsPromoted } for eventTimelines" },
        "timeline4": { "type": "object", "encrypted": false, "description": "{ name, state, enabled, startDate, endDate, winnerCount } for eventTimelines" },
        "winners": { "type": "array", "encrypted": false, "description": "Array of { teamId, rank, title } for eventWinners" },
        "updatedAt": { "type": "timestamp", "encrypted": false, "description": "For eventWinners" }
      }
    }
  }
}