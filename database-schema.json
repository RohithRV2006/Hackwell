{
  "collections": {
    "teams": {
      "description": "Stores information about registered hackathon teams and their members. Team name acts as the unique identifier.",
      "documentId": "teamName (lowercase, trimmed)",
      "fields": {
        "teamName": { "type": "string", "encrypted": false },
        "problemStatement": { "type": "string", "encrypted": false },
        "leadEmail": { "type": "string", "encrypted": false },
        "leadData": { "type": "object", "encrypted": false },
        "membersData": { "type": "array", "encrypted": false },
        "totalGameXP": { "type": "number", "encrypted": false, "description": "Sum of all XP from gameScores" },
        "prelimsAverageScore": { "type": "number", "encrypted": false, "description": "Average of all prelimsEvaluations" },
        "prelimsStatus": { "type": "string", "encrypted": false, "description": "e.g., 'selected', 'rejected', 'pending'" },
        "finaleAverageScore": { "type": "number", "encrypted": false, "description": "Average of all finaleEvaluations" },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "roles": {
      "description": "Stores authentication and role mapping for privileged users. Document ID is the user email (lowercase).",
      "documentId": "email (lowercase)",
      "fields": {
        "role": { "type": "string", "encrypted": false, "description": "'admin', 'jury', 'student-coord', or 'faculty-coord'" },
        "juryId": { "type": "string", "encrypted": false, "description": "Reference to jury collection" },
        "coordId": { "type": "string", "encrypted": false, "description": "Reference to studentCoords collection" },
        "facultyCoordId": { "type": "string", "encrypted": false, "description": "Reference to facultyCoords collection" },
        "encryptedCreds": { "type": "string", "encrypted": true },
        "scoresFrozen": { "type": "boolean", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "jury": {
      "description": "Jury member profile details.",
      "documentId": "Auto-generated ID",
      "fields": {
        "juryName": { "type": "string", "encrypted": false },
        "institution": { "type": "string", "encrypted": false },
        "email": { "type": "string", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "studentCoords": {
      "description": "Student Coordinator profile details.",
      "documentId": "Auto-generated ID",
      "fields": {
        "name": { "type": "string", "encrypted": false },
        "department": { "type": "string", "encrypted": false },
        "email": { "type": "string", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "facultyCoords": {
      "description": "Faculty Coordinator profile details.",
      "documentId": "Auto-generated ID",
      "fields": {
        "name": { "type": "string", "encrypted": false },
        "department": { "type": "string", "encrypted": false },
        "email": { "type": "string", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "prelimsEvaluations": {
      "description": "Prelims scoring submitted by Juries. Multiple juries can evaluate the same team.",
      "documentId": "Auto-generated ID",
      "fields": {
        "teamId": { "type": "string", "encrypted": false },
        "juryId": { "type": "string", "encrypted": false },
        "rubric": {
          "type": "object",
          "description": "{ innovation, technicalFeasibility, impact, presentation }"
        },
        "totalScore": { "type": "number", "encrypted": false },
        "remarks": { "type": "string", "encrypted": false },
        "highlighted": { "type": "boolean", "encrypted": false },
        "isFrozen": { "type": "boolean", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false },
        "updatedAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "finaleEvaluations": {
      "description": "Finale scoring submitted by Juries. Very similar to prelimsEvaluations.",
      "documentId": "Auto-generated ID",
      "fields": {
        "teamId": { "type": "string", "encrypted": false },
        "juryId": { "type": "string", "encrypted": false },
        "rubric": {
          "type": "object",
          "description": "{ innovation, technicalFeasibility, impact, presentation }"
        },
        "totalScore": { "type": "number", "encrypted": false },
        "remarks": { "type": "string", "encrypted": false },
        "highlighted": { "type": "boolean", "encrypted": false },
        "isFrozen": { "type": "boolean", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false },
        "updatedAt": { "type": "timestamp", "encrypted": false }
      }
    },
    "gameScores": {
      "description": "Game XP assigned by student coordinators during the event.",
      "documentId": "Auto-generated ID",
      "fields": {
        "teamId": { "type": "string", "encrypted": false },
        "studentCoordId": { "type": "string", "encrypted": false },
        "gameName": { "type": "string", "encrypted": false },
        "xpPoints": { "type": "number", "encrypted": false },
        "createdAt": { "type": "timestamp", "encrypted": false }
      }
    }
  }
}
